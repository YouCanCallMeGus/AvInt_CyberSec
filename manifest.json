{
  "manifest_version": 2,
  "name": "CyberCheck",
  "version": "1.0.0",
  "description": "Detecta conexoes de terceira parte, cookies, storage HTML5, canvas fingerprint, cookie sync/bounce e indicadores de hijacking. Calcula um score de privacidade por pagina.",
  "author": "Gustavo Santana Silva",

  "browser_specific_settings": {
    "gecko": {
      "id": "cybercheck@insper.com",
      "strict_min_version": "115.0"
    }
  },

  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "cookies",
    "storage",
    "tabs",
    "webNavigation",
    "<all_urls>"
  ],

  "background": {
    "scripts": ["data/psl.js", "data/trackers.js", "background.js"],
    "persistent": true
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/detector.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],

  "browser_action": {
    "default_title": "CyberCheck",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },

  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  }
}
